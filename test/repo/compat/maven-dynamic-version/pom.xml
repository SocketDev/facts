<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dynamic-version conformance fixture for the Maven core extension.

  Nothing here names a version the emitter is expected to report. The project
  version comes from `-Drevision`, which the harness generates per run, and the
  dependencies are asked for by a range and a SNAPSHOT that the resolver has to
  widen against the generated local repository. An implementation that reads a
  cache, or parses this pom statically, produces `[1.0,2.0)` / a stale version
  and fails.

  The local repository (localrepo/) is generated by
  ../lib/dynamic-version-workspace.mts, and the harness passes a settings.xml
  that mirrors Central to an unreachable URL, so the build cannot reach the
  network for any of it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>demo</groupId>
  <artifactId>socket-facts-dynver</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <repositories>
    <repository>
      <id>socket-facts-fixture</id>
      <url>file://${project.basedir}/localrepo</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>demo.dyn</groupId>
      <artifactId>gadget</artifactId>
      <version>[1.0,2.0)</version>
    </dependency>
    <dependency>
      <groupId>demo.dyn</groupId>
      <artifactId>sprocket</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
</project>
